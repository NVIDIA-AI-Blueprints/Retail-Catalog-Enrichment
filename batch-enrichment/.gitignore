# Generated by the benchmark. Every one of these is reproducible from a command.
#
# data/     the catalog is deterministic from --seed; enrichment output is a run artifact
# reports/  each record is a measurement from a specific GPU on a specific day, so it
#           describes the machine that produced it rather than this repo
data/
reports/
*.log

